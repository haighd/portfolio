# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local archive for accidental duplicate files (macOS " 2" copies)
/_archive

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# package-lock.json (project uses bun)
package-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# velite content layer
.velite

# pagefind search index (generated at build time)
public/pagefind

# resume files (privacy)
docs/resume/*.pdf
docs/resume/*.md
docs/resume/*.docx
docs/resume/*.pdf_original
docs/resume/.pdf-pages/
docs/resume/.pdf-previews/
docs/resume/.Rhistory
docs/resume/graphify-out/

# linkedin optimization content (privacy)
docs/linkedin-optimization-content.md
docs/linkedin-images/

# claude code config (local only)
.claude/

# Local session-state cache (not versioned)
.agents/project.md
.agents/session-journal.md
